{
  "name": "lauhata-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website do Lauhata (restaurante e alojamento), Liquiçá, Timor-Leste — Elevate Web Studio",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "prelaunch": "node build.mjs --strict",
    "preview": "node build.mjs && npx --yes http-server@14.1.1 dist -p 8080 -c-1",
    "fotos": "powershell -ExecutionPolicy Bypass -File tools/otimizar-fotos.ps1",
    "fotos:temporarias": "node tools/fotos-temporarias.mjs",
    "fotos:temporarias:otimizar": "powershell -ExecutionPolicy Bypass -File tools/otimizar-temporarias.ps1"
  }
}
